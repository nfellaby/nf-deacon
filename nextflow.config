params {
    input              = null
    outdir             = 'results'
    publish_dir_mode   = 'copy'

    // Deacon index: give an existing .idx, or a FASTA to build one from,
    // otherwise the prebuilt index named below is fetched (needs internet access)
    deacon_index       = null
    deacon_reference   = null
    deacon_index_name  = 'panhuman-1'
    deacon_index_cache = "${projectDir}/.deacon_index"   // fetched indexes are kept here

    save_filtered_reads = true
}

process {
    shell         = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    resourceLimits = [ cpus: 16, memory: 64.GB, time: 24.h ]

    withLabel: process_single {
        cpus   = 1
        memory = { 2.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 8
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: process_high {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
}

profiles {
    conda {
        conda.enabled = true
    }
    mamba {
        conda.enabled  = true
        conda.useMamba = true
    }
    docker {
        docker.enabled = true
        wave.enabled   = true
        wave.strategy  = 'conda'
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        wave.enabled         = true
        wave.strategy        = 'conda'
        wave.freeze          = true
    }
}

includeConfig 'conf/modules.config'

manifest {
    name            = 'deacon-depletion'
    description     = 'Deacon host depletion of simulated human reads with a cross-sample summary'
    nextflowVersion = '>=24.04.0'
    mainScript      = 'main.nf'
}
