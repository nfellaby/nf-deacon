params {
    input               = null
    outdir              = 'results'
    publish_dir_mode    = 'copy'

    // Which platforms to simulate: 'illumina', 'ont' or 'illumina,ont'
    platforms           = 'illumina,ont'

    // Shared
    seed                = 42
    min_contig_length   = 10000     // drop contigs shorter than this before simulating

    // Illumina (DWGSIM): read pairs per assembly; other options in conf/modules.config
    illumina_read_pairs = 2000000

    // ONT (PBSIM3): depth per assembly and error model; other options in conf/modules.config
    ont_depth           = 10
    pbsim_model         = 'https://raw.githubusercontent.com/yukiteruono/pbsim3/master/data/ERRHMM-ONT-HQ.model'

    // The human-pangenomics bucket is public; set false if your inputs need credentials
    aws_anonymous       = true

    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

aws {
    client {
        anonymous = params.aws_anonymous
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

process {
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 3

    withName: '.*:DWGSIM' {
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    withLabel: process_low {
        cpus = 1
        memory = "4 GB"
        time = "1h"
    }

    withLabel: process_medium {
        cpus = 4
        memory = "12 GB"
        time = "4h"
    }

    withLabel: process_high {
        cpus = 8
        memory = "24 GB"
        time = "8h"
    }
}

executor {
    queueSize = 50
}


profiles {

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
            cacheDir = "${projectDir}/.apptainer"
        }
    }

    slurm {
        process.executor = "slurm"
        process.queue = "htc"
    }

    conda {
        conda.enabled = true
    }
    mamba {
        conda.enabled  = true
        conda.useMamba = true
    }
    docker {
        docker.enabled = true
        wave.enabled   = true
        wave.strategy  = 'conda'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        wave.enabled           = true
        wave.strategy          = 'conda'
        wave.freeze            = true
    }
}

includeConfig 'conf/modules.config'

manifest {
    name            = 'synth-reads'
    description     = 'Simulate Illumina (DWGSIM) and ONT (PBSIM3) reads from genome assemblies'
    nextflowVersion = '>=23.10.0'
    mainScript      = 'main.nf'
}