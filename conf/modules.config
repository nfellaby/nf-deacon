process {

    publishDir = [
        path:   { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode:   params.publish_dir_mode,
        saveAs: { filename -> filename == 'versions.yml' ? null : filename }
    ]

    withName: '.*:DEACON_INDEX_FETCH' {
        // Kept outside work/ so the 3.3 GB index is only downloaded once
        storeDir   = { params.deacon_index_cache }
        publishDir = [ enabled: false ]
    }

    withName: '.*:DEACON_INDEX_BUILD' {
        // e.g. '-k 31 -w 15' (defaults)
        ext.args   = ''
        publishDir = [ enabled: false ]
    }

    withName: '.*:DEACON_FILTER' {
        // Thresholds, e.g. '-a 2 -r 0.01' (defaults) or '-a 1 -r 0' for high sensitivity
        ext.args   = ''
        publishDir = [
            path:   { "${params.outdir}/deacon/${meta.platform}" },
            mode:   params.publish_dir_mode,
            saveAs: { filename ->
                if (filename == 'versions.yml') return null
                if (filename.endsWith('.fastq.gz') && !params.save_filtered_reads) return null
                filename
            }
        ]
    }

    withName: '.*:SUMMARISE_DEPLETION' {
        publishDir = [
            path:   { params.outdir },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }
}
